# ---------------------------------------------------------------------------
# KotaLabs CRM web app — environment template
# Copy to `.env.local` for local development. NEVER commit `.env.local`.
# ---------------------------------------------------------------------------

# Where Next.js proxies /api/* requests during development.
# The browser only ever talks to the Next.js origin, so this stays server-side.
BACKEND_URL=http://localhost:4000

# Optional: call the API directly instead of through the Next.js proxy.
# Leave empty (default) to use same-origin /api requests.
NEXT_PUBLIC_API_URL=
