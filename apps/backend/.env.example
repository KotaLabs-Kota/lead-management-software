# ---------------------------------------------------------------------------
# KotaLabs CRM backend — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Generate secrets with:  openssl rand -hex 32
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# PostgreSQL connection string.
# Local Docker:  postgres://crm:crm_dev_password@localhost:5432/kotalabs_crm
DATABASE_URL=postgres://crm:crm_dev_password@localhost:5432/kotalabs_crm

# Auth secrets — must be at least 32 characters each and different from each other.
JWT_ACCESS_SECRET=replace_me_with_openssl_rand_hex_32_char_minimum
JWT_ACCESS_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30

# Comma separated list of allowed browser origins (Next.js CRM).
CORS_ORIGINS=http://localhost:3000

# Rate limiting (per IP).
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=600
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# Phone normalization: country used when the caller omits a country code.
DEFAULT_COUNTRY_CODE=IN

# Call events: when true, an incoming/outgoing call whose number matches an
# existing lead is automatically linked to that lead. Call events never create
# leads automatically, so repeated calls cannot duplicate leads.
CALL_EVENT_AUTO_LINK_LEAD=true

# Bootstrap admin created by `npm run db:seed` (dev only — change it in production).
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@kotalabs.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_EMPLOYEE_PASSWORD=Employee@12345
